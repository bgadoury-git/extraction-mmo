# syntax=docker/dockerfile:1
# Multi-stage build for the orchestrator service.
# Requires the Docker socket to be bind-mounted at runtime:
#   -v /var/run/docker.sock:/var/run/docker.sock

# ── Stage 1: cargo-chef base ──────────────────────────────────────────────
FROM rust:slim-bookworm AS chef
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    cmake \
    git \
    && rm -rf /var/lib/apt/lists/*
RUN cargo install cargo-chef --locked
WORKDIR /workspace

# ── Stage 2: dependency planner ───────────────────────────────────────────
FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# ── Stage 3: dependency cache ─────────────────────────────────────────────
FROM chef AS builder
COPY --from=planner /workspace/recipe.json recipe.json
RUN cargo chef cook --release -p orchestrator --recipe-path recipe.json

# ── Stage 4: build the orchestrator binary ────────────────────────────────
COPY . .
RUN cargo build --release -p orchestrator

# ── Stage 5: minimal runtime image ────────────────────────────────────────
FROM debian:bookworm-slim AS runtime
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /workspace/target/release/orchestrator /usr/local/bin/orchestrator

# Configurable via docker-compose env (see docker-compose.yml for defaults).
ENV REDIS_URL="redis://redis:6379"
ENV GATEKEEPER_ADDR="gatekeeper:3001"
ENV GAME_IMAGE="game-server:latest"
ENV GAME_NETWORK="game-net"
ENV CERTS_VOLUME="extraction-mmo-certs"
ENV QUIC_PORT_RANGE_START=7000
ENV QUIC_PORT_RANGE_END=7100

# Docker socket is bind-mounted at runtime — no EXPOSE needed.

CMD ["orchestrator"]
